<Window x:Class="WPF_FirstApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_FirstApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Name="tbHello" Text="Hello world" HorizontalAlignment="center" VerticalAlignment="center" FontSize="30" />
            <Button Name="btnRun" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="center" Content="Run" FontSize="20" Click="btnRun_Click"/>
        </StackPanel>
    </Grid>
</Window>
